# ==========================================
# Fraud Rule Engine & Review Console Config
# ==========================================

# Database Configuration (Supports SQLite and PostgreSQL)
# Default SQLite:
DATABASE_URL=sqlite:///./data/fraud_engine.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/fraud_engine

# API authentication and browser origins
API_KEY=
CORS_ORIGINS=http://localhost:5173

# High Risk Alert Threshold (0 to 100)
HIGH_RISK_THRESHOLD=60.0
CRITICAL_RISK_THRESHOLD=80.0

# AWS Credentials for SES and SNS Notifications
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Simple Email Service (SES)
SES_SENDER_EMAIL=fraud-alerts@example.com
SES_ALERT_RECIPIENT=security-ops@example.com

# AWS Simple Notification Service (SNS)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:fraud-critical-alerts
SNS_PHONE_NUMBER=

# Force Mock/Simulation Mode (Set to false when live AWS credentials are provided)
FORCE_MOCK_NOTIFICATIONS=false
# Set true in production to fail if live SES/SNS cannot deliver.
REQUIRE_LIVE_NOTIFICATIONS=false
